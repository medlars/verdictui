"""Owner deletion rules for destructive-action-gate.sh (INS-18201669, CTS-7186D7DE).

The owner's rule is a TRIPLE-CHECK, not a prohibition. A matched deletion stops
once with the facts (what it would destroy) and asks for a review; the same
command re-run with a first line

    # DELETION-REVIEW: 1) reason 2) consequences 3) backup 4) following steps

(each answer 10+ characters, the shape of the gate's DESTRUCTIVE-ACK) proceeds.
Exit 3 = review required, exit 0 = proceed.

Matched: ~/Projects, $HOME or an ancestor; a recursive delete of an unresolved
variable (on 2026-09-30 one resolved to ~/Projects and wiped 25 repos,
CIS-E94F28E0); a repo root; a file under $HOME removed with `rm` rather than
`trash`. For the first three the backup answer must name a backup that exists
(rule 1: back up a repo before deleting it). Temp roots and build/cache dirs
are never matched.
"""

from __future__ import annotations

import glob
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import NamedTuple

__all__ = [
    "CHANGE_TOKEN_TTL_S",
    "EXEMPT_PARTS",
    "GUARDED_VERBS",
    "TOKEN_TTL_S",
    "Finding",
    "backup_token_valid",
    "change_token_fresh",
    "findings",
    "is_real_dir",
    "main",
    "ordinary_location",
    "review_answers",
    "store_paths",
    "within",
]

EXEMPT_PARTS = frozenset(
    {
        "build",
        ".build",
        "dist",
        "out",
        "target",
        "node_modules",
        "__pycache__",
        "DerivedData",
        ".tox",
        ".venv",
        "venv",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".cache",
    }
)
TOKEN_TTL_S = 24 * 3600
REVIEW_REQUIRED = 3  # not 2: python itself exits 2 when the script cannot be opened
_ASSIGN = re.compile(r"""(?:^|[\s;&|(])([A-Za-z_][A-Za-z0-9_]*)=("[^"\n]*"|'[^'\n]*'|\$\([^)\n]*\)|[^\s;&|]+)""")
_VAR = re.compile(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?")
_HEREDOC = re.compile(r"<<-?\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?")
_GLOB = re.compile(r"[*?\[]")
_WRAPPERS = frozenset(
    {
        "sudo",
        "command",
        "env",
        "nice",
        "nohup",
        "time",
        "builtin",
        "exec",
        "xargs",
        "doas",
        "timeout",
        "gtimeout",
        "caffeinate",
        "stdbuf",
        "arch",
        "xcrun",
        "busybox",
        "noglob",
        "nocorrect",
        "setsid",
        "ionice",
        "taskpolicy",
        "unbuffer",
        "chronic",
    }
)
# Every verb this policy parses. The gate's bash prefilter must match a superset
# (tests/test_owner_file_guard.py enumerates spellings), or a verb reaches bash unjudged.
DELETE_VERBS = frozenset({"rm", "trash", "rmdir", "unlink", "shred", "srm"})
COPY_VERBS = frozenset({"cp", "install", "ditto", "rsync", "ln"})
CHMOD_VERBS = frozenset({"chmod", "chown", "chgrp"})
EDIT_VERBS = frozenset({"sed", "gsed", "perl", "ruby", "awk", "gawk", "tee", "truncate", "dd"})
SHELL_VERBS = frozenset({"sh", "bash", "zsh", "dash", "ksh", "fish", "eval"})
GUARDED_VERBS = DELETE_VERBS | COPY_VERBS | CHMOD_VERBS | EDIT_VERBS | SHELL_VERBS | {"mv", "find"}
CHANGE_TOKEN_TTL_S = 30 * 60
DEFAULT_CAP = 2000
# Words that open a compound command: `if x; then rm -rf ~/Projects; fi` put
# `then` in the verb slot, so the rm was never seen (found 2026-10-01).
_KEYWORDS = frozenset({"{", "}", "!", "if", "then", "else", "elif", "do", "while", "until", "exec", "xargs"})


def _heredoc_tag(line: str) -> str | None:
    """The delimiter of a real heredoc opened on this line, else None.

    bash opens a heredoc only for an UNQUOTED `<<` that is not the `<<<` here-string; a regex search
    treated `cat <<< x` and `echo '<<EOF'` as heredocs and hid every later line (parser differential,
    security review 2026-10-05). Arithmetic and $'..' are ambiguous: scanned as code.
    """
    if "((" in line:
        return None  # arithmetic: `<<` may be a left shift, so the following lines are scanned as code
    quote = ""
    i = 0
    while i < len(line):
        ch = line[i]
        if quote:
            if ch == "\\" and quote in ('"', "$'"):
                i += 1  # in "..." and $'...' a backslash escapes the next character
            elif ch == quote[-1]:
                quote = ""
        elif line.startswith("$'", i):
            quote = "$'"
            i += 1
        elif ch in "'\"":
            quote = ch
        elif ch == "\\":
            i += 1
        elif line.startswith("<<<", i):
            i += 2
        elif line.startswith("<<", i):
            match = _HEREDOC.match(line, i)
            if match:
                return match.group(1)
            i += 1
        i += 1
    return None


def _terminated(lines: list[str], start: int, tag: str) -> bool:
    return any(line.strip() == tag for line in lines[start:])


def _strip_heredocs(text: str) -> str:
    out: list[str] = []
    terminator: str | None = None
    lines = text.splitlines()
    for n, line in enumerate(lines):
        if terminator is not None:
            if line.strip() == terminator:
                terminator = None
            continue
        out.append(line)
        tag = _heredoc_tag(line)
        # An unterminated heredoc is data to bash, but hiding the rest of the command on that
        # reading is the unsafe side: scan it instead.
        if tag and _terminated(lines, n + 1, tag):
            terminator = tag
    return "\n".join(out)


def _assignments(text: str) -> dict[str, str | None]:
    found: dict[str, str | None] = {}
    for name, raw in _ASSIGN.findall(text):
        value = raw.strip("'\"")
        # Placeholder path naming a temp root for the policy to judge; nothing is created or opened here.
        found[name] = "/tmp/mktemp" if value.startswith("$(mktemp") else (None if "$(" in value or "`" in value else value)  # nosec B108
    return found


_HIDE = {ch: chr(0xE000 + i) for i, ch in enumerate(";&|()")}
_SHOW = {ord(v): k for k, v in _HIDE.items()}


def _hide_escaped(code: str) -> str:
    """Hide a separator only when bash reads it as a literal: unquoted and after an ODD backslash run.

    A backslash escapes the next character, so `\\\\;` is an escaped backslash followed by a REAL
    separator; a regex that hid any `\\;` swallowed the second command (review 2026-10-05). Quotes
    are tracked so quoted text is left to the lexer, which already keeps it inside one word.
    """
    out: list[str] = []
    quote = ""
    i = 0
    while i < len(code):
        ch = code[i]
        if quote:
            out.append(ch)
            if ch == "\\" and quote == '"' and i + 1 < len(code):
                out.append(code[i + 1])
                i += 1
            elif ch == quote:
                quote = ""
        elif ch in "'\"":
            quote = ch
            out.append(ch)
        elif ch == "\\" and i + 1 < len(code):
            nxt = code[i + 1]
            out.append(_HIDE.get(nxt, "\\" + nxt))
            i += 1
        elif ch == "&" and ((out and out[-1] in "<>") or code[i + 1 : i + 2] == ">"):
            # `2>&1` and `&>file` are redirects, not a background separator: splitting there made
            # `2>&1 rm x` read as the command `1 rm x` (differential, CIS-719E68BC).
            out.append(_HIDE["&"])
        else:
            out.append(ch)
        i += 1
    return "".join(out)


def _track_parens(token: str, after_dollar: bool, kinds: list[tuple[str, int]], n: int, good: set[int] | None) -> list[int]:
    """Push/pop the parens of one punctuation token; return the token indexes of arithmetic spans it closed.

    `kinds` holds (kind, opening token index), innermost last. A `$((` span is arithmetic only when
    it closes with a contiguous `))`; `$((rm f) )` is a substitution holding a subshell in bash, so
    `good` (from a first pass) gates which opens count as arithmetic and the rest are commands.
    """
    closed: list[int] = []
    i = 0
    while i < len(token):
        ch = token[i]
        if ch == "(":
            if after_dollar and token.startswith("((", i) and (good is None or n in good):
                kinds.append(("arith", n))
                i += 1
            elif after_dollar and token.startswith("((", i):
                kinds.extend([("sub", n), ("group", n)])
                i += 1
            else:
                kinds.append(("sub" if after_dollar else "group", n))
            after_dollar = False
        elif ch == ")" and kinds:
            kind, start = kinds.pop()
            if kind == "arith":
                if token.startswith("))", i):
                    closed.append(start)
                    i += 1
                else:
                    kinds.append(("sub", start))  # a lone `)`: bash read `$( (`, so the span is not arithmetic
        i += 1
    return closed


def _arithmetic_spans(tokens: list[str]) -> set[int]:
    """Token indexes of every `$((` that closes with a contiguous `))`."""
    kinds: list[tuple[str, int]] = []
    good: set[int] = set()
    for n, token in enumerate(tokens):
        if token and all(ch in ";&|()" for ch in token):
            good.update(_track_parens(token, bool(n and tokens[n - 1].endswith("$")), kinds, n, None))
    return good


def _in_arithmetic(kinds: list[tuple[str, int]]) -> bool:
    for kind, _ in reversed(kinds):
        if kind != "group":
            return kind == "arith"
    return False


def _segments(text: str) -> list[list[str]]:
    # Lines are joined with `;`, so shlex's own comment handling would let one
    # `#` hide every LATER line -- a leading `# anything` disabled this policy.
    # Drop whole-line comments here and end a segment at an unquoted `#` word.
    code = "\n".join(line for line in text.splitlines() if not line.lstrip().startswith("#"))
    # A backslash-escaped ; & | ( ) is a plain word character to bash (`find \\( -name x \\)`), but the
    # lexer split on it and cut the command in pieces. Hide it behind a placeholder until the
    # token is stored.
    code = _hide_escaped(code)
    lexer = shlex.shlex(code.replace("\n", " ; "), posix=True, punctuation_chars=";&|()")
    lexer.whitespace_split = True
    lexer.commenters = ""
    segments: list[list[str]] = [[]]
    in_comment = False
    tokens = list(lexer)
    kinds: list[tuple[str, int]] = []  # open parens, innermost last: "arith" for `$((`, "sub" for `$(`, else "group"
    good = _arithmetic_spans(tokens)
    for n, token in enumerate(tokens):
        if token and all(ch in ";&|()" for ch in token):
            _track_parens(token, bool(n and tokens[n - 1].endswith("$")), kinds, n, good)
            segments.append([])
            in_comment = False
        elif _in_arithmetic(kinds):
            continue  # `$(( a % 5 * $(date) ))`: the text between substitutions is arithmetic, not commands
        elif in_comment or token.startswith("#"):
            in_comment = True
        else:
            segments[-1].append(token.translate(_SHOW))
    return [seg for seg in segments if seg]


_LEADING_REDIRECT = re.compile(r"(?:\d*|&)(?:>>|>\||>|<)(&?\S+)?")


class _WrapperOpts(NamedTuple):
    flags: str = ""  # short letters that take no value
    values: str = ""  # short letters whose value is the rest of the cluster or the next word
    long_values: frozenset[str] = frozenset()  # options (any dash count) whose value is the next word
    long_flags: frozenset[str] = frozenset()


# Each wrapper's options, so an option VALUE (`env -u sed python3 ...`, `sudo -u op rm ...`) is never taken
# for the command word. An option not listed here makes the resolution ambiguous, and then every possible
# command word in the segment is judged (security reviews of #359, CTS-E967B657).
_WRAPPER_OPTS: dict[str, _WrapperOpts] = {
    "sudo": _WrapperOpts(
        "AbEeHiKklnPSsVv",
        "ughpUCDrtTR",
        frozenset({"--user", "--group", "--host", "--prompt", "--other-user", "--close-from", "--chdir", "--chroot"})
        | frozenset({"--role", "--type", "--command-timeout"}),
        frozenset({"--preserve-env", "--login", "--shell", "--non-interactive", "--stdin", "--background"})
        | frozenset({"--set-home", "--askpass", "--bell", "--reset-timestamp"}),
    ),
    "doas": _WrapperOpts("Lns", "uC"),
    "env": _WrapperOpts(
        "i0v", "uCP", frozenset({"--unset", "--chdir"}), frozenset({"--ignore-environment", "--null", "--debug"})
    ),
    "nice": _WrapperOpts("", "n", frozenset({"--adjustment"})),
    "timeout": _WrapperOpts(
        "fpv", "sk", frozenset({"--signal", "--kill-after"}), frozenset({"--foreground", "--preserve-status", "--verbose"})
    ),
    "xargs": _WrapperOpts(
        "0oprtx",
        "EIJLnPRSsd",
        frozenset({"--max-args", "--max-procs", "--delimiter", "--arg-file", "--eof", "--max-lines"}),
        frozenset({"--null", "--no-run-if-empty", "--verbose", "--exit", "--open-tty", "--interactive"}),
    ),
    "stdbuf": _WrapperOpts("", "ioe", frozenset({"--input", "--output", "--error"})),
    "caffeinate": _WrapperOpts("dimsu", "tw"),
    "exec": _WrapperOpts("cl", "a"),
    "command": _WrapperOpts("pvV"),
    "setsid": _WrapperOpts("fwc"),
    "chronic": _WrapperOpts("ev"),
    "unbuffer": _WrapperOpts("p"),
    "ionice": _WrapperOpts("t", "cnp"),
    "time": _WrapperOpts("lph"),
    "arch": _WrapperOpts(
        long_values=frozenset({"-e", "-d", "-arch"}),
        long_flags=frozenset({"-arm64", "-arm64e", "-x86_64", "-x86_64h", "-i386", "-32", "-64", "-c"}),
    ),
    "xcrun": _WrapperOpts(
        long_values=frozenset({"--sdk", "-sdk", "--toolchain", "-toolchain"}),
        long_flags=frozenset({"-r", "--run", "-v", "--verbose", "-l", "--log", "-n", "--no-cache"}),
    ),
}
_WRAPPER_OPTS["gtimeout"] = _WRAPPER_OPTS["timeout"]


def _env_split(word: str, segment: list[str], i: int) -> tuple[int, str] | None:
    """`env -S STR` in any spelling (`-S`, `-iS'..'`, `--split-string`, `--s=..`): (next index, STR)."""
    name, eq, value = word.partition("=")
    if len(name) >= 3 and name.startswith("--") and "--split-string".startswith(name):
        # getopt_long takes any unambiguous prefix, and no other env long option starts with --s
        if eq:
            return i + 1, value
        return (i + 2, segment[i + 1]) if i + 1 < len(segment) else (i + 1, "")
    if word.startswith("-") and not word.startswith("--"):
        cluster = word[1:]
        for n, letter in enumerate(cluster):
            if letter == "S":
                rest = cluster[n + 1 :]
                if rest:
                    return i + 1, rest
                return (i + 2, segment[i + 1]) if i + 1 < len(segment) else (i + 1, "")
            if letter not in _WRAPPER_OPTS["env"].flags:
                return None  # `-uS` unsets S: a value letter (or an unknown one) owns the rest of the cluster
    return None


def _wrapper_options(name: str, segment: list[str], i: int) -> tuple[int, bool, str | None]:
    """Skip wrapper `name`'s options from index i: (next index, any option not understood, `env -S` string)."""
    opts = _WRAPPER_OPTS.get(name, _WrapperOpts())
    unknown = False
    while i < len(segment):
        word = segment[i]
        if word == "--":
            i += 1
            break
        if name == "env" and word == "-":
            i += 1  # `env -` is `env -i`
            continue
        if not word.startswith("-") or word == "-":
            break
        split = _env_split(word, segment, i) if name == "env" else None
        if split is not None:
            # env splits this string into a command line and runs it: judge it as a shell command line
            return split[0], unknown, split[1]
        name_part, eq, _ = word.partition("=")
        if word in opts.long_flags or name_part in opts.long_flags:
            i += 1
        elif name_part in opts.long_values:
            i += 1 if eq else 2
        elif word.startswith("--") or (name in ("arch", "xcrun")):
            unknown, i = True, i + 1
        elif name == "nice" and re.fullmatch(r"-\d+", word):
            i += 1  # the old `nice -5 cmd` form
        else:
            step = 1
            for k, letter in enumerate(word[1:]):
                if letter in opts.values:
                    step = 2 if k == len(word) - 2 else 1
                    break
                if letter not in opts.flags:
                    unknown = True
                    break
            i += step
    if name in ("timeout", "gtimeout") and i < len(segment):
        i += 1  # the DURATION operand (strtod accepts inf, 1e3, hex); a missing one only errors
    return i, unknown, None


def _resolve(segment: list[str]) -> tuple[int, bool, str | None]:
    """Index of the command word, whether that choice is uncertain, and an `env -S` command line.

    After a wrapper, a word that is not a guarded verb, interpreter or runner makes the choice uncertain:
    an option or operand this table misreads must not hide the command behind it (security reviews of #362)."""
    i = 0
    ambiguous = False
    wrapped = False
    in_env = False
    while i < len(segment):
        word = segment[i]
        redirect = _LEADING_REDIRECT.fullmatch(word)
        if redirect:
            # `>/dev/null rm x` runs rm: a redirect before the command word is not the command word. A bare
            # operator (`> /dev/null rm x`) takes the next word as its target.
            i += 1 if redirect.group(1) else 2
            continue
        wrapper = os.path.basename(word).lower()  # `/usr/bin/env -S 'rm x'` is env too
        if wrapper in _WRAPPERS:
            wrapped = True
            in_env = wrapper == "env"
            i, unknown, split = _wrapper_options(wrapper, segment, i + 1)
            ambiguous = ambiguous or unknown
            if split is not None:
                return i, ambiguous, split
            continue
        if (in_env and "=" in word) or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", word) or word in _KEYWORDS:
            i += 1  # env takes ANY word with `=` as an assignment (`a-b=1`), the shell only identifiers
            continue
        break
    if wrapped and i < len(segment):
        word = os.path.basename(segment[i]).lower()
        ambiguous = ambiguous or not (word in GUARDED_VERBS or _runs_program(word))
    return i, ambiguous, None


def _verb(segment: list[str]) -> tuple[str | None, list[str]]:
    i, ambiguous, split = _resolve(segment)
    if split is not None:
        # env appends the remaining words to the split command line, so they are part of what runs
        line = split + (" " + shlex.join(segment[i:]) if i < len(segment) else "")
        return "sh", ["-c", line]
    if i >= len(segment):
        return None, []
    words = [os.path.basename(w).lower() for w in segment]  # APFS is case-insensitive: `RM` runs rm
    if ambiguous and words[i] not in GUARDED_VERBS:
        # The choice is uncertain: prefer the first guarded word, then the first interpreter or runner;
        # _segment_findings also judges every other candidate.
        for test in (lambda w: w in GUARDED_VERBS, _runs_program):
            for j in range(i, len(segment)):
                if test(words[j]):
                    return words[j], segment[j + 1 :]
    return words[i], segment[i + 1 :]


def _expand(arg: str, env: dict[str, str | None]) -> str | None:
    if arg == "~" or arg.startswith("~/"):
        arg = os.environ.get("HOME", "") + arg[1:]
    unresolved = False

    def sub(match: re.Match[str]) -> str:
        nonlocal unresolved
        name = match.group(1)
        if name in env and env[name] is not None:
            # bash expands `~` and `$VAR` when the variable is ASSIGNED; substituting the raw value judged
            # "~/Documents/x" as a relative path and let the delete through (CTS-3837C229).
            value = _expand(str(env[name]), {k: v for k, v in env.items() if k != name})
            if value is None:
                unresolved = True
                return ""
            return value
        if name == "PWD":
            cwds = _cwds()  # bash sets PWD to the directory it runs in, not this process's inherited value
            if len(cwds) == 1:
                return cwds[0]
        elif name in ("HOME", "TMPDIR") and os.environ.get(name):
            return os.environ[name]
        unresolved = True
        return ""

    expanded = _VAR.sub(sub, arg)
    if unresolved or "$(" in arg or "`" in arg:
        return None
    return expanded


def _cwds() -> list[str]:
    """Every directory a relative path may mean: the session cwd the dispatcher read from the payload
    (CLAUDE_HOOK_CWD) and this process's own. Hook-process cwd and session cwd are different facts
    (security review 2026-10-05), so a relative target is judged against both."""
    out: list[str] = []
    for cand in (os.environ.get("CLAUDE_HOOK_CWD", ""), os.getcwd()):
        if cand and os.path.isabs(cand) and cand not in out:
            out.append(cand)
    return out


def _real(path: str) -> Path:
    return Path(os.path.realpath(os.path.join(_cwds()[0], path)))


def _token_dir() -> Path:
    default = Path(os.environ.get("HOME", "")) / ".claude" / "state" / "repo-backups"
    return Path(os.environ.get("CLAUDE_BACKUP_TOKEN_DIR") or default)


def backup_token_valid(repo: Path) -> bool:
    # A lookup key shared with `shasum -a 1` in the backup script, not a security hash.
    key = hashlib.sha1(str(repo).encode(), usedforsecurity=False).hexdigest()[:16]
    token = _token_dir() / f"repo-backup-{key}"
    try:
        if time.time() - token.stat().st_mtime > TOKEN_TTL_S:
            return False
        archive = Path(token.read_text().strip())
        return archive.is_file() and archive.stat().st_size > 0
    except OSError:
        return False


def _within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def _parse_args(verb: str, args: list[str]) -> tuple[bool, list[str]]:
    recursive = verb == "trash"
    targets: list[str] = []
    end_of_flags = False
    for arg in args:
        if not end_of_flags and arg == "--":
            end_of_flags = True
        elif not end_of_flags and arg.startswith("-"):
            short = not arg.startswith("--") and re.search("[rR]", arg)
            recursive = recursive or arg == "--recursive" or bool(short)
        else:
            targets.append(arg)
    return recursive, targets


class Finding(NamedTuple):
    target: str
    why: str
    needs_backup: bool
    # The owner's folders and files: no review or backup unlocks these, only the owner does.
    owner_only: bool = False
    # A change (move, edit, chmod, overwrite) allowed once a backup and a report exist.
    needs_token: bool = False


# Owner 2026-10-04 (CTS-24E2B3F5): folders "related to Claude, Codex, Cursor, GLM, KIMI,
# or other coding stuff" may be deleted with a review and an existing backup; every
# other ordinary folder or file under $HOME is the owner's to delete.
# Coding-tool data is an ALLOW-LIST of exact locations, never a substring match on a
# name: ~/Documents/Android Photos and ~/Pictures/yarn-art are the owner's (security
# review of the Sentinel mirror, 2026-10-04).
