        "codex",
        "cursor",
        "code",
        "zed",
        "jetbrains",
        "ollama",
        "docker",
        "windsurf",
        "kimi",
        "glm",
        "grok",
        "gemini",
        "copilot",
        "github copilot",
        "androidstudio",
        "xcode",
    }
)
_CODING_PREFIXES = (("Library", "Developer"), ("Library", "Caches"), ("Library", "Logs"), (".cache",), (".local",), (".config",))


def _coding_related(target: Path, home: Path) -> bool:
    parts = target.relative_to(home).parts
    if any(parts[: len(prefix)] == prefix for prefix in _CODING_PREFIXES):
        return True
    if parts and parts[0].lower() in _TOOL_DOTDIRS:
        return True
    return len(parts) >= 3 and parts[:2] == ("Library", "Application Support") and parts[2].lower() in _TOOL_APP_SUPPORT


def _ordinary_location(path: Path, home: Path, is_dir: bool) -> bool:
    """Under $HOME and none of: ~/Projects, build/cache dirs, coding-tool data, inside a repository."""
    if not _within(path, home) or path == home:
        return False
    rel = path.relative_to(home).parts
    if _within(path, home / "Projects") or EXEMPT_PARTS.intersection(rel):
        return False
    if len(rel) == 1 and not is_dir and rel[0].startswith("."):
        return False  # ~/.zshrc, ~/.gitconfig: tool configuration, not the owner's documents
    if _coding_related(path, home):
        return False
    node = path if is_dir else path.parent
    while node != home and node != node.parent:
        if (node / ".git").exists():
            return False
        node = node.parent
    return True


def _is_real_dir(path: Path) -> bool:
    return path.is_dir() and not path.is_symlink()


def _ordinary_folder(target: Path, home: Path) -> bool:
    """A directory under $HOME that is none of: ~/Projects, a repository, coding-tool data.

    Holding a repository does not change that: the non-repository contents are the owner's ordinary
    files. _target_finding downgrades only a folder PROVEN to hold nothing but repositories."""
    return _is_real_dir(target) and _ordinary_location(target, home, True)


def _ordinary_file(target: Path, home: Path) -> bool:
    """An existing non-directory (a symlink counts) whose parent chain is an ordinary location."""
    return os.path.lexists(target) and not _is_real_dir(target) and _ordinary_location(target, home, False)


def _change_subject(real: Path, home: Path) -> bool:
    return os.path.lexists(real) and _ordinary_location(real, home, _is_real_dir(real))


def _owner_folder(target: Path) -> Finding:
    return Finding(
        str(target),
        "is one of the owner's ordinary folders; only the owner may delete it (no review unlocks it)",
        False,
        owner_only=True,
    )


def _owner_file(target: Path) -> Finding:
    return Finding(
        str(target),
        "is a file in one of the owner's ordinary folders; only the owner may delete it (no review unlocks it)",
        False,
        owner_only=True,
    )


def _state_dir() -> Path:
    return Path(os.path.realpath(os.environ.get("HOME", "/nonexistent"))) / ".claude" / "state"


def _store_paths() -> tuple[Path, Path]:
    return _state_dir() / "owner-backups", _state_dir() / "owner-change-reports.jsonl"


def _protects_store(target: Path) -> bool:
    """The backups and the report log are the owner's evidence: no agent deletes them, or any ancestor."""
    backups, reports = _store_paths()
    return any(_within(store, target) or _within(target, store) for store in (backups, reports))


# Ticket text that NAMES the store (CIS-0F3BE18D). destructive-action-gate.sh refuses any command that
# mentions the store unless every verb is a plain reader. That refusal also hit a ticket filed with
# `python3.15 -m central_issue_store --add --description '...'` whose prose named the folder. Exactly one
# form is cleared here: a single-line call of one ticket CLI whose store name sits only in the value of a
# text option. Everything else, including every read-only grep/sqlite/cat the gate refuses, stays refused
# as before: a read can build the name at run time, and each widening is a new hole.
_STORE_NAMES = ("owner-backups", "owner-change-reports")
_TICKET_MODULES = frozenset({"central_issue_store", "central_todo_store", "central_advisory_registry", "instruction_store"})
_TICKET_TEXT_OPTIONS = frozenset(
    {"--description", "--note", "--title", "--problem", "--rationale", "--how-to", "--resolution", "--instruction"}
)
_TRUSTED_PYTHON = re.compile(r"(?:/opt/homebrew/bin/|/usr/bin/)?python3\.1[45]")
_EXPANSION_CHARS = re.compile(r"[$~*?\[{]")


def _store_words(cmd: str) -> list[list[tuple[str, bool, str]]] | None:
    """Split a command into segments of (word, is_redirect_target, raw source text of the word).

    None when the command cannot be read safely: a command substitution, backtick, process
    substitution or heredoc outside single quotes, a comment, or an unbalanced quote."""
    segments: list[list[tuple[str, bool, str]]] = [[]]
    word: list[str] = []
    in_word = False
    redirect = False
    quote = ""
    start = 0
    i, n = 0, len(cmd)

    def end_word() -> None:
        nonlocal word, in_word, redirect
        if in_word:
            text = "".join(word)
            if not (redirect and text.startswith("&")):  # 2>&1 duplicates a descriptor, it names no file
                segments[-1].append((text, redirect, cmd[start:i]))
            redirect = False
        word, in_word = [], False

    while i < n:
        ch = cmd[i]
        nxt = cmd[i + 1] if i + 1 < n else ""
        if quote == "'":
            if ch == "'":
                quote = ""
            else:
                word.append(ch)
            i += 1
            continue
        if ch == "`" or (ch == "$" and nxt == "(") or ch in "<>":
            return None  # any redirect, here-string, <> or process substitution outside single quotes
        if quote == '"':
            if ch == '"':
                quote = ""
            elif ch == "\\" and nxt in '$`"\\':
                word.append(nxt)
                i += 1
            else:
                word.append(ch)
            i += 1
            continue
        if not in_word and ch not in " \t;&|()\n":
            if ch == "#":
                return None  # an unquoted # at a word start opens a comment that hides what follows
            start = i
        if ch in "'\"":
            quote, in_word = ch, True
        elif ch == "\\" and nxt:
            word.append(nxt)
            in_word = True
            i += 1
        elif ch in ";&|()\n":
            end_word()
            redirect = False
            if segments[-1]:
                segments.append([])
        elif ch in " \t":
            end_word()
        else:
            word.append(ch)
            in_word = True
        i += 1
    if quote:
        return None
    end_word()
    return [seg for seg in segments if seg]


def _names_store(text: str) -> bool:
    return any(name in text for name in _STORE_NAMES)


_TEXT_UNSAFE = re.compile(r"[$`\\{}*?\[\]~#!<>|;&()\r\n]")


def _literal_ticket_text(raw: str) -> bool:
    """True when the shell passes this ticket-text value through unchanged, so it can be skipped unread.

    One rule: the value is entirely one single-quoted span, or it holds none of the characters the
    shell expands, splits, redirects or comments on."""
    return re.fullmatch(r"'[^']*'", raw) is not None or _TEXT_UNSAFE.search(raw) is None


def store_mention_is_harmless(cmd: str) -> bool:
    """True only for one single-line `python3.15 -m <ticket CLI> ...` whose store name sits in a text option."""
    if "\n" in cmd or "\r" in cmd:
        return False
    segments = _store_words(cmd)
    if segments is None or len(segments) != 1:
        return False
    seg = segments[0]
    if any(is_target for _text, is_target, _raw in seg):
        return False
    words = [text for text, _target, _raw in seg]
    raws = [raw for _text, _target, raw in seg]
    # The CLIs are run as `PYTHONPATH=<shared-libs> python3.15 -m ...`: that one prefix, with only
    # that value (~ and $HOME resolved here, never by trusting the text), is the sole assignment allowed.
    if words and words[0].startswith("PYTHONPATH="):
        home = os.environ.get("HOME", "")
        trusted = {"shared-libs", "~/Projects/shared-libs", "$HOME/Projects/shared-libs"}
        if home:
            trusted.add(f"{home}/Projects/shared-libs")
        if words[0].partition("=")[2] not in trusted:
            return False
        words, raws = words[1:], raws[1:]
    if len(words) < 3 or not _TRUSTED_PYTHON.fullmatch(words[0]) or words[1] != "-m" or words[2] not in _TICKET_MODULES:
        return False
    args, arg_raws, i = words[3:], raws[3:], 0
    while i < len(args):
        option, eq, _inline = args[i].partition("=")
        if option in _TICKET_TEXT_OPTIONS:
            value_raw = arg_raws[i].partition("=")[2] if eq else None
            if not eq:
                i += 1  # the next word is the value
                if i >= len(args):
                    return False
                value_raw = arg_raws[i]
            if value_raw is None or not _literal_ticket_text(value_raw):
                return False
            i += 1
            continue
        if _names_store(args[i]) or _EXPANSION_CHARS.search(args[i]):
            return False
        i += 1
    return True


def change_token_fresh(real: Path) -> bool:
    """True when the backup helper ran for EXACTLY this path within the last 30 minutes.

    No ancestor walk: a token for a folder once vouched for every file inside it (security
    review of PR #285), so one backup unlocked edits to files that were never copied.
    """
    key = hashlib.sha256(str(real).encode()).hexdigest()
    token = _store_paths()[0] / "tokens" / key
    try:
        if time.time() - token.stat().st_mtime > CHANGE_TOKEN_TTL_S:
            return False
        row = json.loads(token.read_text(encoding="utf-8"))
        # A token whose backup is gone (approved, swapped or deleted) vouches for nothing.
        return row.get("path") == str(real) and isinstance(row.get("backup"), str) and os.path.lexists(row["backup"])
    except (OSError, ValueError, AttributeError):
        return False


def _facts(path: Path) -> str:
    """What the deletion would destroy, so the review answers from evidence."""
    if not path.exists():
        return "does not exist"
    if path.is_file():
        return f"file, {path.stat().st_size} bytes"
    count = 0
    for _ in path.rglob("*"):
        count += 1
        if count >= 20000:
            break
    parts = [f"{count}{'+' if count >= 20000 else ''} entries"]
    if (path / ".git").exists():
        for label, cmd in (
            ("uncommitted", ["git", "-C", str(path), "status", "--porcelain"]),
            ("unpushed commits", ["git", "-C", str(path), "log", "--oneline", "@{u}..HEAD"]),
        ):
            try:
                out = subprocess.run(cmd, capture_output=True, text=True, timeout=3, check=False)
                parts.append(f"{len(out.stdout.splitlines())} {label}" if out.returncode == 0 else f"{label}: unknown")
            except (OSError, subprocess.TimeoutExpired):
                parts.append(f"{label}: unknown")
    return ", ".join(parts)


_REPO_SCAN_LIMIT = 20000


def _holds_repository(root: Path) -> bool:
    """True if any directory under root is a repository; True when unsure (fail closed)."""
    unreadable: list[OSError] = []
    seen = 0
    # os.walk skips a directory it cannot read unless onerror records it; an
    # unread directory could hold a repository, so it counts as one.
    for _dirpath, dirnames, filenames in os.walk(root, followlinks=False, onerror=unreadable.append):
        if unreadable:
            return True
        if ".git" in dirnames or ".git" in filenames:
            return True
        # A bare repository has no .git entry: HEAD beside objects/ and refs/.
        if "HEAD" in filenames and "objects" in dirnames and "refs" in dirnames:
            return True
        seen += len(dirnames) + len(filenames)
        if seen > _REPO_SCAN_LIMIT:
            return True
    return bool(unreadable)


def _only_repositories(root: Path) -> bool:
    """True only when a COMPLETE scan shows every entry under root is a repository or a folder of them.

    Tri-state collapsed to a boolean on purpose: unreadable, oversized and "has a non-repository
    file" all answer False, and False is the owner-only side.
    """
    budget = _REPO_SCAN_LIMIT
    found = False

    def walk(folder: Path) -> bool:
        nonlocal budget, found
        try:
            entries = list(os.scandir(folder))
        except OSError:
            return False
        budget -= len(entries)
        if budget < 0:
            return False
        for entry in entries:
            if entry.name == ".DS_Store":
                continue
            if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                return False
            path = Path(entry.path)
            try:
                has_git = (path / ".git").exists()
            except OSError:
                return False
            if has_git:
                found = True
            elif not walk(path):
                return False
        return True

    return walk(root) and found


def _target_finding(verb: str, target: Path, home: Path) -> Finding | None:
    projects = home / "Projects"
    if _protects_store(target):
        return Finding(
            str(target), "holds the owner's change backups and reports; only the owner may remove them", False, owner_only=True
        )
    if target == home or _within(projects, target):
        return Finding(str(target), "is ~/Projects, $HOME or an ancestor of them", True)
    # Temp roots live outside $HOME, so they fall out here with everything else
    # the gate's other arms already judge.
    if not _within(target, home):
        return None
    if EXEMPT_PARTS.intersection(target.relative_to(home).parts) or target.suffix == ".pyc":
        return None
    repo = target.parent if target.name == ".git" else target
    if (repo / ".git").exists() or (repo.parent == projects and _is_real_dir(repo)):
        return Finding(str(repo), f"is a repository ({_facts(repo)})", True)
    # Owner 2026-10-04: a folder CONTAINING repositories needs a backup, but an ordinary folder is the
    # owner's. So an ordinary folder is reviewable only when PROVEN to hold nothing but repositories
    # (~/Code of clones); a photo folder with one nested repo, an unreadable or oversized folder
    # (unsure) stays owner-only. Outside ordinary locations (~/Projects, coding-tool data) any
    # repository holder is reviewable as before.
    if _ordinary_folder(target, home):
        if _only_repositories(target):
            return Finding(str(target), "is a directory containing repositories", True)
        return _owner_folder(target)
    if _is_real_dir(target) and _holds_repository(target):
        return Finding(str(target), "is a directory containing repositories", True)
    if _ordinary_file(target, home):
        return _owner_file(target)
    if _is_real_dir(target) and (_within(target, projects) or _coding_related(target, home)):
        if verb == "trash":
            return None  # recoverable from the Trash
        return Finding(str(target), f"is a ~/Projects or coding-tool folder ({_facts(target)})", True)
    if verb == "rm":
        # `trash` is recoverable from the Trash; `rm` is not, so only rm is reviewed.
        return Finding(str(target), f"is a file under $HOME removed with rm, not trash ({_facts(target)})", False)
    return None


# ── operand expansion, capped ────────────────────────────────────────────────
# bash expands braces then globs, so a word can name thousands of paths. An expansion
# past the cap is not skipped: it fails closed wherever it could reach an ordinary
# location (security review of PR #282, 2026-10-04).
def _cap() -> int:
    try:
        return max(1, int(os.environ.get("DELETION_POLICY_CAP", DEFAULT_CAP)))
    except ValueError:
        return DEFAULT_CAP


class _TooMany(Exception):
    def __init__(self, prefix: str) -> None:
        super().__init__(prefix)
        self.prefix = prefix


_RANGE = re.compile(r"(-?\d+)\.\.(-?\d+)(?:\.\.(-?\d+))?|([A-Za-z])\.\.([A-Za-z])(?:\.\.(-?\d+))?")


def _static(word: str) -> str:
    return re.split(r"[{*?\[]", word, maxsplit=1)[0]


def _alternatives(body: str, cap: int, prefix: str) -> list[str] | None:
    parts: list[str] = []
    depth = 0
    cur = ""
    for ch in body:
        depth += (ch == "{") - (ch == "}")
        if ch == "," and depth == 0:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    parts.append(cur)
    if len(parts) > 1:
        return parts
    match = _RANGE.fullmatch(body)
    if not match:
        return None
    if match.group(1) is not None:
        lo, hi = int(match.group(1)), int(match.group(2))
        step = abs(int(match.group(3) or 1)) or 1
        if abs(hi - lo) // step + 1 > cap:
            raise _TooMany(prefix)
        width = max(len(match.group(1)), len(match.group(2))) if "0" in (match.group(1)[:1], match.group(2)[:1]) else 0
        seq = range(lo, hi + 1, step) if lo <= hi else range(lo, hi - 1, -step)
        return [str(n).zfill(width) for n in seq]
    lo_c, hi_c = ord(match.group(4)), ord(match.group(5))
    step = abs(int(match.group(6) or 1)) or 1
    seq = range(lo_c, hi_c + 1, step) if lo_c <= hi_c else range(lo_c, hi_c - 1, -step)
    return [chr(n) for n in seq]


def _brace_expand(word: str) -> list[str]:
    """bash brace expansion (comma lists and ranges); more than the cap raises _TooMany."""
    cap = _cap()
    prefix = _static(word)

    def rec(w: str) -> list[str]:
        at = 0
        while True:
            start = w.find("{", at)
            if start < 0:
                return [w]
            depth = 0
            end = -1
            for k in range(start, len(w)):
                depth += (w[k] == "{") - (w[k] == "}")
                if depth == 0:
                    end = k
                    break
            if end < 0:
                return [w]
            alts = _alternatives(w[start + 1 : end], cap, prefix)
            if alts is None:
                at = start + 1
                continue
            out: list[str] = []
            for alt in alts:
                out += rec(w[:start] + alt + w[end + 1 :])
                if len(out) > cap:
                    raise _TooMany(prefix)
            return out

    return rec(word)


def _glob_matches(word: str) -> list[str]:
    cap = _cap()
    out: list[str] = []
    for match in glob.iglob(word):
        out.append(match)
        if len(out) > cap:
            raise _TooMany(_static(word))
    return out


class _Ctx:
    """What one command is judged against: the home, every directory it may run in, its text."""

    def __init__(self, text: str, raw: str = "") -> None:
        self.raw = raw or text
        self.heredocs_done = False
        self.home = Path(os.path.realpath(os.environ.get("HOME", "/nonexistent")))
        self.bases = _cwds()
        self.text = text
        self.guarded = False
        self._mention: bool | None = None

    def reals(self, path: str) -> list[Path]:
        bases = [""] if os.path.isabs(path) else self.bases  # a cd may or may not persist: judge each
        return [Path(os.path.realpath(os.path.join(base, path.rstrip("/") or "/"))) for base in bases]

    def cd(self, args: list[str], env: dict[str, str | None]) -> None:
        word = next((a for a in args if not a.startswith("-")), "~")
        self._mention = None  # bases only grow, so a stale False here would fail open (CTS-E967B657)
        expanded = _expand(word, env)
        if expanded is None:
            self.bases.append(str(self.home))  # unknowable: assume the worst place too
            return
        self.bases.append(str(self.reals(expanded)[-1]))

    def ordinary_dir(self, path: Path) -> bool:
        return path == self.home or _ordinary_location(path, self.home, True)

    def names_ordinary(self) -> bool:
        return any(self._token_ordinary(tok) for tok in re.split(r"""[\s;&|()<>'"`=,:]+""", self.text))

    def mentions(self) -> bool:
        """True when the command names, or runs in, an ordinary location."""
        if self._mention is None:
            self._mention = any(self.ordinary_dir(Path(os.path.realpath(b))) for b in self.bases) or self.names_ordinary()
        return self._mention

    def _token_ordinary(self, token: str) -> bool:
        if "/" not in token and not token.startswith("~"):
            return False
        expanded = _expand(token, {})
        if expanded is None:
            return False
        prefix = _static(expanded) or "."
        for real in self.reals(prefix):
            if _ordinary_location(real, self.home, real.is_dir()) or _ordinary_location(real.parent, self.home, True):
                return True
        return False


_REWRITE_MARK = "(rewrite: save the program to a file and run that file)"


def _closed_program(why: str) -> Finding:
    """A program the gate cannot read: refused, but the session fixes it itself by running it from a file."""
    # Not _closed(): its "only the owner may run it" suffix would contradict the rewrite banner.
    return Finding("(command)", f"{why}; the policy cannot read it {_REWRITE_MARK}", False, owner_only=True)


def _closed(why: str, target: str = "(command)") -> Finding:
    return Finding(target, f"{why}; the policy cannot see what it touches, so only the owner may run it", False, owner_only=True)


def _too_many(prefix: str, ctx: _Ctx) -> Finding | None:
    """The word expands past the cap: fail closed unless every possible path is clearly elsewhere."""
    expanded = _expand(prefix, {}) or prefix
    for real in ctx.reals(os.path.dirname(expanded) if not expanded.endswith("/") else expanded or "."):
        if ctx.ordinary_dir(real):
            return _closed(f"expands to too many paths (more than {_cap()}) under {real}", prefix or ".")
    return None


def _operands(raws: list[str], env: dict[str, str | None], ctx: _Ctx) -> tuple[list[str], list[Finding]]:
    """Every path word the shell would build from these operands; problems fail closed."""
    problems: list[Finding] = []
    paths: list[str] = []
    if len(raws) > _cap():
        return [], [_closed(f"names too many operands (more than {_cap()})")] if ctx.mentions() else []
    for raw in raws:
        expanded = _expand(raw, env)
        if expanded is None:
            if ctx.mentions():
                problems.append(_closed(f"{raw!r} is built at run time"))
            continue
        try:
            for word in _brace_expand(expanded):
                paths.append(word)
                if _GLOB.search(word):
                    paths += _glob_matches(word)
        except _TooMany as exc:
            hit = _too_many(exc.prefix, ctx)
            if hit:
                problems.append(hit)
    return paths, problems


def _delete_findings(verb: str, args: list[str], env: dict[str, str | None], ctx: _Ctx) -> list[Finding]:
    recursive, targets = _parse_args(verb, args)
    effective = "trash" if verb == "trash" else "rm"
    found: list[Finding] = []
    for raw in targets:
        if _expand(raw, env) is None and recursive:
            found.append(Finding(raw, "is an unresolved variable; on 2026-09-30 one resolved to ~/Projects", True))
            continue
        paths, problems = _operands([raw], env, ctx)
        found += problems
        for word in paths:
            # A glob is judged by its static prefix: `~/Projects/*` deletes every repo.
            static = _GLOB.split(word, maxsplit=1)[0] or "."
            for real in ctx.reals(static):
                hit = _target_finding(effective, real, ctx.home)
                if hit and verb == "rmdir" and not hit.owner_only:
                    hit = None  # rmdir removes only empty folders: the Projects/coding review is for rm
                if hit:
                    found.append(hit)
            if _GLOB.search(word):
                continue
            for real in ctx.reals(word):
                lexical = Path(os.path.realpath(real.parent)) / real.name
                if lexical != real:  # a link inside an ordinary folder is removed, not what it points to
                    hit = _target_finding(effective, lexical, ctx.home)
                    if hit and hit.owner_only:
                        found.append(hit)
    return found


def findings(verb: str, args: list[str], env: dict[str, str | None]) -> list[Finding]:
    return _delete_findings(verb, args, env, _Ctx(""))


def _need_token(paths: list[str], ctx: _Ctx, why: str) -> list[Finding]:
    found: list[Finding] = []
    seen: set[Path] = set()
    for word in paths:
        for real in ctx.reals(_GLOB.split(word, maxsplit=1)[0] or "."):
            if real in seen:
                continue
            seen.add(real)
            if _change_subject(real, ctx.home) and not change_token_fresh(real):
                found.append(Finding(str(real), why, False, needs_token=True))
    return found


_INPLACE = re.compile(r"-[0-9A-Za-z]*i[^\s]*|--in-place(=.*)?")


def _edits_in_place(verb: str, args: list[str]) -> bool:
    if verb in ("sed", "gsed", "perl", "ruby"):
        return any(_INPLACE.fullmatch(a) for a in args if a.startswith("-"))
    return verb in ("awk", "gawk") and "inplace" in " ".join(args)


def _split_copy_args(args: list[str]) -> tuple[list[str], str | None, list[str]]:
    """(operands, -t directory, flags) for mv/cp-like commands."""
    ops: list[str] = []
    flags: list[str] = []
    target_dir: str | None = None
    it = iter(args)
    end_of_flags = False
    for arg in it:
        if end_of_flags or not arg.startswith("-") or arg == "-":
            ops.append(arg)
        elif arg == "--":
            end_of_flags = True
        elif arg in ("-t", "--target-directory"):
            target_dir = next(it, None)
        elif arg.startswith("--target-directory="):
            target_dir = arg.split("=", 1)[1]
        elif arg.startswith("-t") and not arg.startswith("--") and len(arg) > 2:
            target_dir = arg[2:]
        else:
            flags.append(arg)
    return ops, target_dir, flags


def _copy_findings(verb: str, args: list[str], env: dict[str, str | None], ctx: _Ctx) -> list[Finding]:
    ops, target_dir, flags = _split_copy_args(args)
    if target_dir is not None:
        sources, dest = ops, target_dir
    elif ops:
        sources, dest = ops[:-1], ops[-1]
    else:
        return []
    found: list[Finding] = []
    src_paths, problems = _operands(sources, env, ctx)
    dest_paths, dest_problems = _operands([dest], env, ctx)
    found += problems + dest_problems
    if verb == "mv":
        found += _need_token(src_paths, ctx, "is moved or renamed")
    if verb == "rsync" and any(f.startswith("--delete") or f == "--remove-source-files" for f in flags):
        for word in dest_paths:
            for real in ctx.reals(word):
                if _change_subject(real, ctx.home):
                    found.append(_closed("rsync --delete removes files from a folder of the owner's", str(real)))
    landing: list[str] = []
    for word in dest_paths:
        if _GLOB.search(word):
            continue
        for real in ctx.reals(word):
            if _is_real_dir(real):
                landing += [str(real / os.path.basename(s.rstrip("/"))) for s in src_paths if s]
            else:
                landing.append(str(real))
    found += _need_token(landing, ctx, "is overwritten" if verb != "mv" else "is replaced by the move")
    return found


def _find_findings(args: list[str], env: dict[str, str | None], ctx: _Ctx) -> list[Finding]:
    roots: list[str] = []
    rest: list[str] = []
    args = [a for a in args if a not in ("-H", "-L", "-P", "-X", "-x", "-s", "-E", "-d")] if not roots else args
    for i, arg in enumerate(args):
        if arg.startswith(("-", "(", "!")):
            rest = args[i:]
            break
        roots.append(arg)
    roots = roots or ["."]
    paths, found = _operands(roots, env, ctx)
    action: str | None = None
    if "-delete" in rest:
        action = "delete"
    for i, arg in enumerate(rest):
        if arg in ("-exec", "-execdir", "-ok", "-okdir") and i + 1 < len(rest):
            cmd_args: list[str] = []
            for word in rest[i + 1 :]:
                if word in (";", "+"):
                    break
                cmd_args.append(word)
            cmd = _verb(cmd_args)[0] or os.path.basename(rest[i + 1])
            if cmd in DELETE_VERBS:
                action = "delete"
            elif action is None and (cmd in GUARDED_VERBS):
                action = "change" if cmd not in SHELL_VERBS else "closed"
            elif action is None and re.match(r"python|perl|ruby|node|osascript", cmd):
                action = "closed"
    reached = [real for word in paths for real in ctx.reals(_GLOB.split(word, maxsplit=1)[0] or ".")]
    if action == "delete":
        for real in reached:
            if _ordinary_folder(real, ctx.home) or _ordinary_file(real, ctx.home):
                found.append(_owner_folder(real) if _is_real_dir(real) else _owner_file(real))
            elif _protects_store(real):
                found.append(_target_finding("rm", real, ctx.home) or _closed("deletes the owner's store"))
    elif action == "change":
        found += _need_token([str(r) for r in reached], ctx, "is changed by find -exec")
    elif action == "closed":
        found += [_closed("find runs a shell or interpreter over it", str(r)) for r in reached if _change_subject(r, ctx.home)]
    return found


def _shell_scripts(verb: str, args: list[str]) -> list[str]:
    if verb == "eval":
        return [" ".join(args)]
    for i, arg in enumerate(args):
        if arg.startswith("-") and not arg.startswith("--") and "c" in arg[1:] and i + 1 < len(args):
            return [args[i + 1]]
    return []


_INLINE_INTERPRETERS = frozenset({"python", "python3", "python3.15", "perl", "ruby", "node"})
# Calls that delete from inside an interpreter one-liner, in the spellings of each language.
_INLINE_DELETE = re.compile(
    r"\b(?:os\.(?:remove|unlink|rmdir|removedirs)|shutil\.rmtree|\.unlink\(|unlink(?:Sync)?\b|rmdir(?:Sync)?\b"
    r"|rmSync\b|fs\.rm\b|File\.delete|FileUtils\.rm|rm_rf|remove_tree|rmtree)"
)
# A program the gate cannot read (inline text or stdin) fails closed near an ordinary folder, whatever it
# says: a content denylist is always one spelling short (`getattr(os,"remove")`, `importlib`,
# `vars(__builtins__)`; Grok and security reviews of #356/#358/#359, CTS-E967B657). Options are an
# ALLOWLIST per interpreter family, so an option this table does not know fails closed too. A script FILE
# is screened when it is written, so running one stays the escape route.
_INTERPRETER = re.compile(
    r"(python|pypy|perl|ruby|irb|node|nodejs|tsx|ts-node|deno|bun|php|lua|luajit|rscript|r|osascript|tclsh|wish"
    r"|julia|swift|pwsh|powershell|jshell|groovy)[0-9.]*(?:-[0-9.]+)?"
)
_FAMILY_ALIAS = {"pypy": "python", "nodejs": "node", "tsx": "node", "ts-node": "node", "luajit": "lua", "wish": "tclsh"}
# Tools that take a command or script as an option value; near an ordinary folder only `<tool> [file]` runs.
_COMMAND_OPTION_TOOLS = frozenset(
    {"vim", "nvim", "vi", "ex", "view", "emacs", "gdb", "lldb", "expect", "elixir", "iex", "erl", "escript"}
    | {"racket", "guile", "sbcl", "clisp", "ecl", "ghci", "runghc", "scala", "kotlin", "clojure", "clj", "bb"}
    | {"nu", "xonsh", "elvish", "ipython", "make", "gmake", "jshell", "groovy", "irb"}
)


class _Spec(NamedTuple):
    flags: str = ""  # short letters that take no value
    values: str = ""  # short letters whose value is the rest of the cluster or the next word
    long_flags: frozenset[str] = frozenset()
    long_values: frozenset[str] = frozenset()  # long options whose value is the next word (or after `=`)
    file_opts: frozenset[str] = frozenset()  # options whose value is the script file
    subcommands: frozenset[str] = frozenset()  # leading words that keep reading options (`deno run`)
    positional_file: bool = True  # the first plain word is the script
    case_insensitive: bool = False


_INFO = frozenset({"--version", "--help", "-v", "-V", "-h", "-version", "-help"})
_SPECS: dict[str, _Spec] = {
    "python": _Spec(flags="uBOIEsSqbdvxPR", values="WX", long_flags=frozenset({"--version", "--help"})),
    "perl": _Spec(flags="wTtnapsc", values="IMm"),
    "ruby": _Spec(flags="wvcdnaps", values="Ir"),
    "node": _Spec(
        long_flags=frozenset(
            {"--no-warnings", "--enable-source-maps", "--trace-warnings", "--no-deprecation", "--expose-gc"}
            | {"--experimental-strip-types", "--experimental-vm-modules", "--test", "--watch", "--inspect"}
        ),
        values="r",
        long_values=frozenset({"--require", "--env-file", "--conditions", "--input-type", "--max-old-space-size"}),
    ),
    "deno": _Spec(flags="Aq", subcommands=frozenset({"run", "task", "test"})),
    "bun": _Spec(subcommands=frozenset({"run", "test"})),
    "php": _Spec(flags="nqH", file_opts=frozenset({"-f"})),
    "lua": _Spec(values="l"),
    "rscript": _Spec(long_flags=frozenset({"--vanilla", "--no-save", "--no-restore", "--quiet", "--slave", "--no-echo"})),
    "r": _Spec(
        long_flags=frozenset({"--vanilla", "--no-save", "--no-restore", "--quiet", "--slave", "--no-echo"}),
        file_opts=frozenset({"-f", "--file"}),
        positional_file=False,
    ),
    "osascript": _Spec(values="ls"),
    "julia": _Spec(flags="q", values="t", long_values=frozenset({"--project", "--threads", "--startup-file", "--color"})),
    "pwsh": _Spec(
        long_flags=frozenset({"-noprofile", "-noninteractive", "-nologo"}),
        long_values=frozenset({"-executionpolicy"}),
        file_opts=frozenset({"-file", "-f"}),
        positional_file=False,
        case_insensitive=True,
    ),
}
_SPECS["powershell"] = _SPECS["pwsh"]
# `python -m <these>` runs code given on the command line or stdin, not a module's own file.
_CODE_MODULES = frozenset({"pdb", "code", "timeit", "trace", "cprofile", "profile", "runpy", "doctest", "idlelib"})
_PERL_MODULE = re.compile(r"-?[\w:]+(?:=[\w,:]+)?")
_RUBY_LIB = re.compile(r"[\w/.:-]+")
# Tools that start the command named among their arguments (`uv run rm ...`, `npx tsx -e ...`).
_RUNNERS = frozenset(
    {"uv", "uvx", "poetry", "pipx", "pdm", "hatch", "rye", "conda", "mamba", "pyenv", "rbenv", "mise", "asdf"}
    | {"bundle", "npx", "pnpm", "yarn", "bunx", "direnv", "op", "dotenv"}
)
_AWK_VERBS = frozenset({"awk", "gawk", "mawk", "nawk"})
# awk reaches files and processes only through these: system(), a single-bar pipe, print redirection, @load.
_AWK_CAPABLE = re.compile(r"\bsystem\b|(?<!\|)\|(?!\|)|\bprintf?\b[^;}\n]*>|@load")
# sqlite3 accepts any unambiguous prefix of a dot-command, so only these read-only ones are allowed.
_SQLITE_READ_ONLY = frozenset(
    {"tables", "table", "schema", "headers", "header", "mode", "indexes", "indices", "databases", "dbinfo"}
    | {"help", "show", "width", "timer", "quit", "exit", "print", "nullvalue", "separator", "eqp", "explain"}
    | {"stats", "changes", "bail", "echo", "fullschema", "lint", "dump"}
)
_SQLITE_DOT = re.compile(r"(?:^|[\s'\";])\.([A-Za-z]\w*)", re.MULTILINE)
_SQLITE_FUNCS = re.compile(r"load_extension|writefile|\bedit\s*\(|fts3_tokenizer", re.IGNORECASE)


def _family(verb: str) -> str | None:
    match = _INTERPRETER.fullmatch(verb.lower())
    if not match:
        return None
    base = match.group(1)
    return _FAMILY_ALIAS.get(base, base)


def _command_words(words: list[str]) -> list[int]:
    """Indexes of every word that names a guarded verb, interpreter or runner."""
    names = [os.path.basename(w).lower() for w in words]
    return [j for j, w in enumerate(names) if w in GUARDED_VERBS or _runs_program(w)]


def _runs_program(word: str) -> bool:
    low = word.lower()
    return low in _RUNNERS or low == "sqlite3" or low in _COMMAND_OPTION_TOOLS or _family(low) is not None


def _stdin_path(path: str) -> bool:
    """`-`, `/dev/stdin`, `/dev/fd/0`, `php://stdin`, `data:` URLs: a "file" the write-time screen never saw."""
    return path in ("", "-") or ":" in path or path.startswith(("/dev/", "/proc/"))


def _short_option(family: str, spec: _Spec, args: list[str], i: int) -> tuple[str, int]:
    """Judge one short-option cluster: ("ok", next index), or ("inline"|"file", _) to stop."""
    cluster = args[i][1:]
    for n, letter in enumerate(cluster):
        rest = cluster[n + 1 :]
        if letter in spec.flags:
            continue
        if family == "python" and letter == "m":
            module = rest or (args[i + 1] if i + 1 < len(args) else "")
            ok = re.fullmatch(r"[\w.]+", module) and module.split(".")[0].lower() not in _CODE_MODULES
            return ("file" if ok else "inline"), i
        if letter in spec.values:
            value = rest or (args[i + 1] if i + 1 < len(args) else "")
            if family == "perl" and letter in "Mm" and not _PERL_MODULE.fullmatch(value):
                return "inline", i  # `-M'POSIX;unlink ...'` injects code
            if family == "ruby" and letter in "Ir" and not _RUBY_LIB.fullmatch(value):
                return "inline", i
            return "ok", i + (1 if rest else 2)
        return "inline", i  # an option this table does not know: fail closed
    return "ok", i + 1


def _program_source(family: str, args: list[str]) -> str:
    """Where an interpreter reads its program: "file", "inline", "stdin" or "none" (version/help only)."""
    spec = _SPECS.get(family, _Spec())
    info_only = True
    seen_subcommand = False
    i = 0
    while i < len(args):
        arg = args[i]
        low = arg.lower() if spec.case_insensitive else arg
        if arg.startswith("<<"):
            return "stdin"  # a heredoc or here-string before any script file is the program
        if arg in ("<", ">", ">>", "2>", "&>"):
            i += 2
            continue
        if arg.startswith(("<", ">")) or _LEADING_REDIRECT.fullmatch(arg):
            i += 1
            continue
        if arg == "-":
            return "stdin"
        if low in _INFO:
            i += 1
            continue
        info_only = False
        name, eq, value = low.partition("=")
        if name in spec.file_opts:
            target = value if eq else (args[i + 1] if i + 1 < len(args) else "")
            # `-f -`, `php://stdin` and `data:` URLs are not files the write-time screen has seen
            return "stdin" if _stdin_path(target) else "file"
        if arg.startswith("--") or (spec.case_insensitive and arg.startswith("-")):
            if "data:" in value:
                return "inline"
            if (name in spec.long_flags and not eq) or (name in spec.long_values and eq):
                i += 1
            elif family == "deno" and name.startswith(("--allow-", "--unstable")):
                i += 1  # permission flags; `--allow-read=dir` keeps its value attached
            elif name in spec.long_values:
                i += 2
            else:
                return "inline"  # unknown long option: its value may be the program
            continue
        if arg.startswith("-") and len(arg) > 1:
            verdict, i = _short_option(family, spec, args, i)
            if verdict != "ok":
                return verdict
            continue
        if spec.subcommands and not seen_subcommand:
            if arg not in spec.subcommands:
                # `deno eval` / `bun x` run text or a package; a path-shaped word is the script itself
                return "file" if ("/" in arg or "." in arg) else "inline"
            seen_subcommand = True
            i += 1
            continue
        if _stdin_path(arg):
            return "stdin"
        return "file" if spec.positional_file else "inline"
    return "none" if info_only and args else "stdin"


def _awk_programs(args: list[str]) -> tuple[list[str], bool]:
    """Every inline awk program in `args`, and whether an extension is loaded (`-l`, `--load`)."""
    programs: list[str] = []
    files = False
    loads = False
    i = 0
    while i < len(args):
        arg = args[i]
        name, eq, value = arg.partition("=")
        if arg == "--":
            i += 1
            break
        if name in ("--source", "--file", "--load", "--assign", "--field-separator", "--include") and not eq:
            value, i = (args[i + 1] if i + 1 < len(args) else ""), i + 1
        if name.startswith("--"):
            programs += [value] if name == "--source" else []
            files = files or name in ("--file", "--include")
            loads = loads or name == "--load"
            i += 1
            continue
        if arg.startswith("-") and len(arg) > 1:
            letter, rest = arg[1], arg[2:]
            if letter in "vFfeilE":
                value = rest or (args[i + 1] if i + 1 < len(args) else "")
                i += 1 if rest else 2
                programs += [value] if letter == "e" else []
                files = files or letter in "fiE"
                loads = loads or letter == "l"
            else:
                i += 1
            continue
        break
    if not files and i < len(args):
        programs.append(args[i])
    return programs, loads


def _program_findings(verb: str, args: list[str], ctx: _Ctx) -> list[Finding]:
    """Interpreters, awk, sqlite3 and command-option tools whose program the gate cannot read."""
    if verb in _AWK_VERBS:
        programs, loads = _awk_programs(args)
        if ctx.mentions() and (loads or any(_AWK_CAPABLE.search(p) for p in programs)):
            return [_closed_program(f"an inline {verb} program can run commands or write files")]
        return []
    if verb == "sqlite3":
        sql = " ".join(args) + "\n" + (ctx.raw or ctx.text)  # stdin (heredoc, pipe) carries the script just as an argument does
        dots = {d.lower() for d in _SQLITE_DOT.findall(sql)}
        if ctx.mentions() and (dots - _SQLITE_READ_ONLY or _SQLITE_FUNCS.search(sql)):
            return [_closed_program("sqlite3 dot-commands or functions can run commands or write files")]
        return []
    if verb in _COMMAND_OPTION_TOOLS:
        if ctx.mentions() and any(a.startswith(("-", "+")) and a not in _INFO for a in args):
            return [_closed_program(f"{verb} options can run commands near an ordinary folder")]
        return []
    family = _family(verb)
    if family is None or not ctx.mentions():
        return []
    source = _program_source(family, args)
    if source in ("inline", "stdin"):
        where = "on the command line" if source == "inline" else "from stdin"
        return [_closed_program(f"{verb} runs a program given {where} near an ordinary folder")]
    return []


def _reads_stdin(args: list[str]) -> bool:
    """True when a shell has no script FILE to read: bare `sh`, `sh -s`, or only options and redirects."""
    if any(a == "-s" or (a.startswith("-") and not a.startswith("--") and "s" in a[1:] and "c" not in a[1:]) for a in args):
        return True  # `bash -s arg...` reads its program from stdin whatever positional words follow
    skip = False
    for arg in args:
        if skip:  # the word after a bare `<<<` or `<` is its data or file, not a script to run
            skip = False
            continue
        if arg in ("<<<", "<"):
            skip = True
        elif not (arg.startswith(("<", "-")) or _LEADING_REDIRECT.fullmatch(arg)):
            return False
    return True


def _heredoc_bodies(text: str) -> str:
    out: list[str] = []
    terminator: str | None = None
    lines = text.splitlines()
    for n, line in enumerate(lines):
        if terminator is not None:
            if line.strip() == terminator:
                terminator = None
            else:
                out.append(line)
            continue
        tag = _heredoc_tag(line)
        if tag and _terminated(lines, n + 1, tag):
            terminator = tag
    return "\n".join(out)


_REDIRECT = re.compile(r"(?:\d*|&)(>>|>\||>)(.*)", re.S)
_SPECIAL_VERB = re.compile(r"[{}*?\[$`]")
# `[ -f x ]` / `[[ ... ]]` are the test builtin: their words are operands, and they never delete.
_TEST_BUILTINS = frozenset({"[", "[["})
_MAX_DEPTH = 4
_MAX_CANDIDATES = 32


def _redirect_findings(segment: list[str], env: dict[str, str | None], ctx: _Ctx) -> list[Finding]:
    targets: list[str] = []
    for i, token in enumerate(segment):
        match = _REDIRECT.fullmatch(token)
        if not match:
            continue
        rest = match.group(2) or (segment[i + 1] if i + 1 < len(segment) else "")
        if rest and not rest.startswith("&"):
            targets.append(rest)
    if not targets:
        return []
    paths, problems = _operands(targets, env, ctx)
    return problems + _need_token(paths, ctx, "is overwritten by a redirect")


def _candidate_findings(words: list[str], starts: list[int], env: dict[str, str | None], ctx: _Ctx, depth: int) -> list[Finding]:
    """Judge each word that could be the command once, as its own segment, without expanding again.

    Re-expanding overlapping suffixes is exponential (`uv uv uv ...`), and a hook that times out fails
    open, so the set is judged flat and capped (third security review of #359)."""
    if len(starts) > _MAX_CANDIDATES:
        return [_closed("too many possible command words to judge")] if ctx.mentions() else []
    found: list[Finding] = []
    for j in starts:
        found += _segment_findings(words[j:], env, ctx, depth, expand=False)
    return found


def _segment_findings(
    segment: list[str], env: dict[str, str | None], ctx: _Ctx, depth: int, expand: bool = True
) -> list[Finding]:
    found = _redirect_findings(segment, env, ctx)
    verb, args = _verb(segment)
    if verb is None:
        return found
    chosen = len(segment) - len(args) - 1
    if expand and _resolve(segment)[1]:
        # A wrapper option the table does not know may have taken the real command word as its value, so
        # every other word that could be the command is judged too (`env --foo sed python3 -c ...`).
        found += _candidate_findings(segment, [j for j in _command_words(segment) if j != chosen], env, ctx, depth)
    # ctx.mentions() is cached on first use, so it is still asked here (same order as before) for `[`.
    if _SPECIAL_VERB.search(verb) and ctx.mentions() and verb not in _TEST_BUILTINS:
        return found + [_closed(f"the command word {verb!r} is built at run time")]
    if verb == "alias" and ctx.mentions():
        return found + [_closed("an alias can rename a delete verb")]
    if verb in _RUNNERS:
        # `uv run rm ...` runs rm. The runner's own option values are not parsed, so EVERY word that could be
        # the command it starts is judged as a segment of its own (security review of #359).
        return found + (_candidate_findings(args, _command_words(args), env, ctx, depth) if expand else [])
    if verb in ("cd", "pushd"):
        ctx.cd(args, env)
        return found
    if verb in GUARDED_VERBS:
        ctx.guarded = True
    stdin_fed = "xargs" in segment and verb in GUARDED_VERBS and verb != "find"
    inline_delete = verb in _INLINE_INTERPRETERS and ctx.mentions() and any(_INLINE_DELETE.search(a) for a in args)
    if verb in DELETE_VERBS:
        found += _delete_findings(verb, args, env, ctx)
        if stdin_fed and ctx.mentions():
            found.append(_closed(f"xargs feeds {verb} paths the policy cannot see"))
    elif verb == "mv" or verb in COPY_VERBS:
        found += _copy_findings(verb, args, env, ctx)
        if stdin_fed and ctx.mentions():
            found.append(_closed(f"xargs feeds {verb} paths the policy cannot see"))
    elif verb in CHMOD_VERBS or verb in ("tee", "truncate") or _edits_in_place(verb, args):
        _flags, operands = _parse_args(verb, args)
        paths, problems = _operands(operands, env, ctx)
        found += problems + _need_token(paths, ctx, "is changed in place")
        if stdin_fed and ctx.mentions():
            found.append(_closed(f"xargs feeds {verb} paths the policy cannot see"))
    elif verb == "dd":
        ofs = [a[3:] for a in args if a.startswith("of=")]
        paths, problems = _operands(ofs, env, ctx)
        found += problems + _need_token(paths, ctx, "is overwritten by dd")
    elif verb == "find":
        found += _find_findings(args, env, ctx)
    elif inline_delete:
        found.append(_closed(f"an inline {verb} script deletes files the policy cannot see"))
    elif verb in SHELL_VERBS:
        if verb != "eval" and ctx.mentions() and not _shell_scripts(verb, args) and _reads_stdin(args):
            found.append(_closed(f"{verb} reads its program from stdin or a here-string"))
        if depth >= _MAX_DEPTH:
            if ctx.mentions():
                found.append(_closed("shell commands nest too deeply"))
        else:
            for script in _shell_scripts(verb, args):
                found += analyze(script, depth + 1, ctx)
            if "<<" in ctx.text and not ctx.heredocs_done:
                ctx.heredocs_done = True  # once: a body is judged one time, not once per nesting level
                body = _heredoc_bodies(ctx.raw)
                ctx.text += "\n" + body
                ctx._mention = None
                found += analyze(body, depth + 1, ctx)
    if verb not in SHELL_VERBS and not inline_delete:
        found += _program_findings(verb, args, ctx)
    return found


class _SubstScan:
    """Quote-aware extraction of bash command substitutions (CIS-05F67AE1, #347/#356).

    A plain paren counter stops at a `)` inside `'...'` or `\"...\"` within `$(...)`, so a
    delete can hide after a quoted parenthesis; backticks need the same quoting rules.
    """

    @staticmethod
    def _dollar_paren_end(text: str, paren_i: int) -> int | None:
        """Index after the `)` that closes `$(` whose `(` is at paren_i."""
        n = len(text)
        depth = 1
        sq = 0
        dqs: dict[int, bool] = {1: False}
        j = paren_i + 1
        while j < n and depth:
            ch = text[j]
            nx = text[j + 1] if j + 1 < n else ""
            if sq:
                if sq == 2 and ch == "\\":
                    j += 2
                    continue
                if ch == "'":
                    sq = 0
                j += 1
                continue
            if ch == "\\":
                j += 2
                continue
            if ch == "$" and nx == "'" and not dqs[depth]:
                sq = 2
                j += 2
                continue
            if ch == "'" and not dqs[depth]:
                sq = 1
                j += 1
                continue
            if ch == '"':
                dqs[depth] = not dqs[depth]
                j += 1
                continue
            if ch == "#" and not dqs[depth] and (j == paren_i + 1 or text[j - 1] in " \t\n;(|&"):
                while j + 1 < n and text[j + 1] != "\n":
                    j += 1
                j += 2 if j + 1 < n else 1
                continue
            if ch == "`" and not dqs[depth]:
                end = _SubstScan._backtick_end(text, j)
                if end is None:
                    return None
                j = end
                continue
            if ch == "$" and nx == "(":
                depth += 1
                dqs[depth] = False
                j += 2
                continue
            if ch == "(" and not dqs[depth]:
                depth += 1
                dqs[depth] = False
                j += 1
                continue
            if ch == ")" and not dqs[depth]:
                depth -= 1
                if depth == 0:
                    return j + 1
                j += 1
                continue
            j += 1
        return None

    @staticmethod
    def _backtick_end(text: str, start: int) -> int | None:
        """Index after the closing backtick for one opening backtick at start."""
        n = len(text)
        depth = 1
        sq = False
        dq = False
        j = start + 1
        while j < n and depth:
            ch = text[j]
            if sq:
                sq = ch != "'"
                j += 1
                continue
            if dq:
                if ch == "\\":
                    j += 2
                    continue
                dq = ch != '"'
                j += 1
                continue
            if ch == "\\":
                j += 2
                continue
            if ch == "'":
                sq = True
                j += 1
                continue
            if ch == '"':
                dq = True
                j += 1
                continue
            if ch == "`":
                depth -= 1
                if depth == 0:
                    return j + 1
                depth += 1
                j += 1
                continue
            j += 1
        return None

    @staticmethod
    def bodies(text: str) -> list[str]:
        out: list[str] = []
        i, n, single, double, ansi = 0, len(text), False, False, False
        while i < n:
            ch = text[i]
            if ansi:
                i += 2 if ch == "\\" else 1
                ansi = ch != "'"
                continue
            if ch == "\\" and not single:
                i += 2
                continue
            if ch == "$" and text[i + 1 : i + 2] == "$" and not single:
                i += 2
                continue
            if ch == "$" and text[i + 1 : i + 2] == "'" and not single and not double:
                ansi = True
                i += 2
                continue
            if ch == "'" and not double:
                single = not single
                i += 1
                continue
            if ch == '"' and not single:
                double = not double
                i += 1
                continue
            if not single and text.startswith("$(", i) and not text.startswith("$((", i):
                end = _SubstScan._dollar_paren_end(text, i + 1)
                if end is None:
                    out.append("'")
                    return out
                out.append(text[i + 2 : end - 1])
                i = end
                continue
            if not single and ch == "`":
                end = _SubstScan._backtick_end(text, i)
                if end is None:
                    out.append("'")
                    return out
                out.append(text[i + 1 : end - 1])
                i = end
                continue
            i += 1
        if single or double or ansi:
            out.append("'")
        return out


def _substituted_commands(text: str) -> list[str]:
    """Inner text of every `$(...)` and backtick pair that bash would expand (not inside single quotes).

    A `'` inside double quotes is a literal character, not a quote: toggling on it hid
    `echo "it's $(rm f)"` from the check (security review 2026-10-07)."""
    return _SubstScan.bodies(text)


_UNBOUNDED_IN_SUBST = re.compile(r"\bcase\b|<<|\$\{")


def _substitution_scan_unsound(text: str) -> bool:
    """True when a `$(` is followed by a construct whose `)` the plain paren scan misreads (CIS-05F67AE1).

    `case x in x)` and `${v//)/}` close the scan early, so the delete after them is never judged; fail closed."""
    start = text.find("$(")
    while start != -1:
        if not text.startswith("$((", start) and _UNBOUNDED_IN_SUBST.search(text, start + 2):
            return True
        start = text.find("$(", start + 2)
    return False


_FUNCTION_DEF = re.compile(r"\bfunction\s+\w|\w[\w.-]*\s*\(\s*\)\s*[{(]|\bcoproc\b|\btrap\b")


def analyze(raw_text: str, depth: int = 0, parent: _Ctx | None = None) -> list[Finding]:
    """Every finding for a command line; a command that cannot be read fails closed."""
    text = _strip_heredocs(raw_text)
    ctx = parent or _Ctx(text, raw_text)
    env = _assignments(text)
    try:
        segments = _segments(text)
    except ValueError:
        guarded_word = any(w in GUARDED_VERBS for w in re.split(r"[^A-Za-z0-9_.-]+", text))
        unreadable = ctx.names_ordinary() or (guarded_word and ctx.mentions())
        return [_closed("its quoting cannot be parsed")] if unreadable else []
    found: list[Finding] = []
    for segment in segments:
        found += _segment_findings(segment, env, ctx, depth)
    if _FUNCTION_DEF.search(text) and ctx.names_ordinary():
        # A function body is never executed by this parser: `function g { rm "$1"; }; g f` reaches rm unseen.
        found.append(_closed("a function, coproc or trap defined in the same command can run a delete verb"))
    if ctx.guarded and ("$(" in text or "`" in text or "<(" in text) and ctx.mentions():
        found.append(_closed("a command substitution may build the paths"))
    elif ctx.mentions() and _substitution_scan_unsound(text):
        found.append(_closed_program("a command substitution holds a case, heredoc or ${...} the paren scan cannot bound"))
    elif depth < _MAX_DEPTH and ctx.mentions():
        # A substitution inside double quotes is one shell word to the lexer, yet bash runs it:
        # `echo "$(rm x)"`. Judge the inner command like any other.
        for inner in _substituted_commands(text):
            found += analyze(inner, depth + 1, ctx)
    return found


def review_answers(text: str) -> list[str] | None:
    """The four answers on the command's first line, or None if absent/incomplete."""
    first = text.split("\n", 1)[0]
    match = re.match(r"\s*#\s*DELETION-REVIEW:(.*)$", first)
    if not match:
        return None
    rest = match.group(1)
    answers: list[str] = []
    for i in range(1, 5):
        if f"{i})" not in rest:
            return None
        rest = rest.split(f"{i})", 1)[1]
        answer = rest.split(f"{i + 1})", 1)[0] if i < 4 else rest
        if len(re.sub(r"\s", "", answer)) < 10:
            return None
        answers.append(answer.strip())
    return answers


_NAME_SEPARATORS = ("-", "_", ".", " ")


def _named_for(name: str, target_name: str) -> bool:
    low, want = name.lower(), target_name.lower()
    return bool(want) and (low == want or any(low.startswith(want + sep) for sep in _NAME_SEPARATORS))


def _nonempty(path: Path) -> bool:
    try:
        return path.stat().st_size > 0 if path.is_file() else any(path.iterdir())
    except OSError:
        return False


def _plausible_backup(candidate: Path, target: Path) -> bool:
    """Backup rule (owner rule 2026-10-04: "a backup that exists outside the target").

    The named path must exist, be non-empty, lie outside the target (not inside it, not an ancestor),
    AND be named for the target: its own basename is the target's basename or begins with it plus a
    separator (x.tar, x-20261005.tar.gz), or it is a folder holding such an entry (a backup root).
    So /etc or an unrelated file no longer "exists" its way past the review. A name is still a claim
    the policy cannot read inside; the helper's token (backup_token_valid) stays the strong proof, and
    the review, which the owner can audit afterwards, stays the record.
    """
    if not candidate.exists() or _within(candidate, target) or _within(target, candidate) or not _nonempty(candidate):
        return False
    if _named_for(candidate.name, target.name):
        return True
    if candidate.is_dir():
        try:
            return any(_named_for(child.name, target.name) and _nonempty(child) for child in candidate.iterdir())
        except OSError:
            return False
    return False


def _backup_ok(finding: Finding, backup_answer: str) -> bool:
    if backup_token_valid(Path(finding.target)):
        return True
    target = _real(finding.target)
    named = re.findall(r"(?:~|/)[^\s,;)\n]+", backup_answer)
    return any(_plausible_backup(_real(os.path.expanduser(raw)), target) for raw in named)


# Executors that can run a delete the policy cannot see; any of them in a reviewed
# command sends it back to the owner.
_INDIRECT = frozenset(
    {
        "bash",
        "sh",
        "zsh",
        "dash",
        "ksh",
        "fish",
        "eval",
        "source",
        ".",
        "exec",
        "xargs",
        "find",
        "parallel",
        "doas",
        "osascript",
        "python",
        "python3",
        "python3.15",
        "perl",
        "ruby",
        "node",
        "unlink",
        "rmdir",
        "shred",
        "srm",
        # shell-state changes alter what a later word expands to
        "cd",
        "pushd",
        "popd",
        "export",
        "declare",
        "typeset",
        "alias",
        "unset",
        "set",
        "readonly",
        "local",
        "builtin",
        "shopt",
    }
)
_DELETE_WORD = re.compile(r"(?<![\w.-])(?:[\w./-]*/)?(?:rm|trash)(?![\w.-])")


_PLAIN_DELETE = re.compile(r"(?:rm|trash)(?:[ \t]+-[A-Za-z]+)*(?:[ \t]+--)?(?:[ \t]+(?:~/|/)[A-Za-z0-9._/+-]+)+")


_PATH_MAKERS = frozenset({"ln", "mv", "cp", "rsync", "ditto", "install"})


def review_accepted(raw_text: str) -> bool:
    """True when a complete review covers only targets this policy judged and accepted.

    The owner's 2026-10-04 rule lets such an rm proceed without asking him. It holds
    only where the policy has authority: every target a file, a repository, or a
    ~/Projects or coding-tool folder under $HOME (folders need an existing backup);
    never one of his ordinary folders, $HOME/~/Projects/an ancestor, an unresolved
    variable, or a path outside $HOME.
    """
    answers = review_answers(raw_text)
    if not answers:
        return False
    # ALLOW-LIST, not a deny-list: three review rounds each found another shell
    # feature (eval, substitution, globs, HOME=) a deny-list missed. A review unlocks
    # exactly one plain line -- rm/trash, simple flags, literal absolute or ~/ paths
    # of safe characters -- and anything else falls back to the owner.
    body = raw_text.split("\n", 1)[1] if "\n" in raw_text else ""
    if not _PLAIN_DELETE.fullmatch(body.strip()):
        return False
    # Fail closed on anything that can delete without being judged below: a
    # substitution or heredoc hides its words from the parser, and a shell, eval,
    # find or xargs runs deletes the policy never sees (second security review of
    # PR #274, 2026-10-04).
    if _strip_heredocs(raw_text) != raw_text or "$(" in raw_text or "`" in raw_text:
        return False
    # Forms bash reads differently from shlex: a line continuation joins a target
    # onto the previous line, $'..' and backslashes decode differently, and a brace
    # list expands into paths the parser never saw.
    body = raw_text.split("\n", 1)[1] if "\n" in raw_text else ""
    if "\\" in body or "$'" in body or '$"' in body or "{" in body.replace("${HOME}", ""):
        return False
    text = raw_text
    env = _assignments(text)
    # Any assignment can change what a later word expands to (HOME=/ turns ~ into /),
    # and the policy judges with this process's environment, not the command's.
    if env:
        return False
    try:
        segments = _segments(text)
    except ValueError:
        return False
    code = "\n".join(line for line in text.splitlines() if not line.lstrip().startswith("#"))
    mentioned = len(_DELETE_WORD.findall(code))
    home = Path(os.path.realpath(os.environ.get("HOME", "/nonexistent")))
    judged = 0
    deletes = 0
    for segment in segments:
        if any(os.path.basename(word) in _INDIRECT for word in segment):
            return False
        verb, args = _verb(segment)
        if verb not in ("rm", "trash"):
            continue
        deletes += 1
        _recursive, targets = _parse_args(verb, args)
        if not targets:
            return False
        for raw in targets:
            # Absolute or home-anchored only: a relative target resolves against the
            # hook's directory, not the session's, so its verdict judges another path.
            if not raw.startswith(("/", "~/", "$HOME/", "${HOME}/")):
                return False
            # A glob is judged by its static prefix, but bash deletes what it MATCHES:
            # ~/P* passes as "~/P" and expands to ~/Projects.
            if _GLOB.search(raw):
                return False
            expanded = _expand(raw, env)
            if expanded is None:
                return False
            static = _GLOB.split(expanded, maxsplit=1)[0] or "."
            target = _real(static.rstrip("/") or "/")
            if not _within(target, home) or target == home:
                return False
            finding = _target_finding(verb, target, home)
            if finding is None or "ancestor" in finding.why or finding.owner_only:
                return False
            if finding.needs_backup and not _backup_ok(finding, answers[2]):
                return False
            judged += 1
    # Every rm/trash word in the code must be a delete this loop judged.
    return judged > 0 and deletes == mentioned


# Public names for owner_changes.py (same directory).
store_paths = _store_paths
within = _within
is_real_dir = _is_real_dir
ordinary_location = _ordinary_location


def _helper_path() -> Path:
    here = Path(__file__).resolve().parents[2] / "scripts" / "owner-change-backup.py"
    return here if here.is_file() else Path(os.environ.get("HOME", "")) / ".claude" / "scripts" / "owner-change-backup.py"


def _rewrite_request(found: list[Finding]) -> str:
    return "\n".join(
        [
            "REWRITE REQUIRED (owner 2026-10-07, CTS-C3B34F1B) -- do NOT ask the owner about this:",
            *(f"  * {f.why.replace(_REWRITE_MARK, '').strip()}" for f in found),
            "",
            "The gate cannot read a program given inline or on stdin near the owner's ordinary folders. Save it",
            "to a file in the session scratchpad (Write tool) and run that file: a script file is screened when",
            "it is written. The owner's instruction for this refusal is exactly that, not an approval request.",
        ]
    )


def _owner_request(found: list[Finding]) -> str:
    return "\n".join(
        [
            "OWNER PERMISSION REQUIRED (owner rule 2026-10-04, CTS-24E2B3F5) -- no review unlocks this:",
            *(f"  * {f.target} {f.why}" for f in found),
            "",
            "Deleting anything in the owner's ordinary folders is his decision alone; ask him. Folders in",
            "~/Projects, repositories and coding-tool folders may be deleted with a DELETION-REVIEW and an",
            "existing backup. Moving, renaming or changing his files is allowed after a backup and a report",
            '(python3.15 owner-change-backup.py <path>... --reason "...").',
        ]
    )


def _token_request(found: list[Finding]) -> str:
    paths = " ".join(shlex.quote(f.target) for f in found)
    return "\n".join(
        [
            "OWNER BACKUP + REPORT REQUIRED (owner rule 2026-10-04, CTS-24E2B3F5) -- back up and report before changing:",
            *(f"  * {f.target} {f.why}" for f in found),
            "",
            "Run this first, then repeat the command (the token lasts 30 minutes):",
            f'  python3.15 {shlex.quote(str(_helper_path()))} {paths} --reason "<why this change>"',
            'The owner approves afterwards by typing "approve changes"; the backup is kept until then.',
        ]
    )


def _review_request(found: list[Finding], answers: list[str] | None) -> str:
    lines = [
        "DELETION REVIEW REQUIRED (owner rule INS-18201669) -- triple-check before deleting:",
        *(f"  * {f.target} {f.why}" for f in found),
        "",
        "Re-run with this as the command's FIRST line (each answer 10+ characters):",
        "  # DELETION-REVIEW: 1) <reason it must go> 2) <consequences: what breaks or is lost>"
        " 3) <backup: the archive path, or why none is needed> 4) <following steps after deleting>",
    ]
    if any(f.needs_backup for f in found):
        lines.append("Answer 3 must name a backup that exists. For a repository:")
        # Offer the helper only where it exists: a remedy naming a script the reader
        # lacks is an unreachable escape route (lesson 1501), and a Sentinel
        # subscriber has no such script. Built from parts so no literal config path
        # sits in the source for the mirror's L1 scan to refuse.
        helper = Path(os.environ.get("HOME", "")) / ".claude" / "scripts" / "backup-repo-before-delete.sh"
        if helper.is_file():
            lines.append(f'  bash {helper} "<repo>"')
        else:
            lines.append("  copy or `git bundle` the repository somewhere outside it, then name that path")
    if answers is not None:
        lines.insert(1, "  (the review given names no existing backup for a repository/root target)")
    lines.append("Prefer `trash <path>` over rm: the Trash is itself a backup.")
    return "\n".join(lines)


# The ONE command shape the rm -rf arm will judge without asking: literal
# assignments, an optional `cd <word> &&`, then one plain rm of literal words.
# Six background security reviews of #278 each found another construct (cd
# options, globs, braces, links made in the same command, wrappers) that a parser
# reads differently from bash; an allow-list ends that class (CIS-75C8A8EC).
_CHARS = r"[A-Za-z0-9._/+-]"
_PLAIN_VAR = r"\$\{?[A-Za-z_][A-Za-z0-9_]*\}?"
_WORD = rf"(?:{_PLAIN_VAR}(?:/{_CHARS}*)?|~/{_CHARS}*|{_CHARS}+)"
_QWORD = rf'(?:"{_WORD}"|{_WORD})'
_PLAIN_RM_RF = re.compile(
    rf"(?P<assigns>(?:[A-Za-z_][A-Za-z0-9_]*=(?:~/)?{_CHARS}+[ \t]*(?:;|&&)[ \t]*)*)"
    rf"(?:cd[ \t]+(?P<cd>{_QWORD})[ \t]*&&[ \t]*)?"
    rf"rm(?P<flags>(?:[ \t]+-[A-Za-z]+)*)(?:[ \t]+--)?(?P<targets>(?:[ \t]+{_QWORD})+)(?:[ \t]+#.*)?[ \t]*"
)
# Names whose value changes how OTHER words resolve; an assignment to one is unreadable.
_RESOLUTION_VARS = frozenset({"HOME", "PWD", "OLDPWD", "CDPATH", "IFS", "PATH"})


# A heredoc whose body is only written to a file: cat > f <<T, cat <<T > f, tee [-a] f <<T
# (optionally >/dev/null). No pipe, substitution or process substitution anywhere.
_SINK_PATH = r"[A-Za-z0-9._/~+-]+"
_TAG = (
    r"<<(?P<dash>-)?[ \t]*(?:'(?P<q1>[A-Za-z_][A-Za-z0-9_]*)'"
    r"|\"(?P<q2>[A-Za-z_][A-Za-z0-9_]*)\"|(?P<w>[A-Za-z_][A-Za-z0-9_]*))"
)
_DATA_SINKS = (
    re.compile(rf"cat[ \t]+>{{1,2}}[ \t]*{_SINK_PATH}[ \t]+{_TAG}"),
    re.compile(rf"cat[ \t]+{_TAG}[ \t]+>{{1,2}}[ \t]*{_SINK_PATH}"),
    re.compile(rf"tee(?:[ \t]+-a)?[ \t]+{_SINK_PATH}[ \t]+{_TAG}(?:[ \t]+>[ \t]*/dev/null)?"),
)


def _sink(line: str) -> re.Match[str] | None:
    for pattern in _DATA_SINKS:
        found = pattern.fullmatch(line.strip())
        if found:
            return found
    return None


def _strict_split(text: str) -> tuple[list[str], bool]:
    """Executable lines, ending each heredoc body EXACTLY where bash does.

    A `<<` is only accepted on a data-sink line with a simple delimiter. A here-string
    (<<<), a quoted "<<", an odd delimiter or a body with no terminator returns
    ok=False, because the lenient stripper treated the lines after them as body and
    hid real commands (eleventh security review of #278).
    """
    code: list[str] = []
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if "<<" not in line:
            if line.strip() and not line.lstrip().startswith("#"):
                code.append(line)
            continue
        found = _sink(line)
        if not found:
            return code, False
        delim = found.group("q1") or found.group("q2") or found.group("w")
        dash = bool(found.group("dash"))
        code.append(line)
        while i < len(lines):
            body = lines[i]
            i += 1
            if (body.lstrip("\t") if dash else body) == delim:
                break
        else:
            return code, False
    return code, True


# Commands that cannot execute a file's contents; with no pipe, substitution,
# separator or redirection into a process they may sit beside a data heredoc.
_INERT_LINE = re.compile(r"(?:chmod|mkdir|echo|printf|true|ls)\b[^|;&`$()<>\n]*")


def _literal_path(word: str, base: str, assigns: dict[str, str]) -> str | None:
    """Resolve one word of the plain grammar to a real path, or None when it cannot be."""
    raw = word[1:-1] if word.startswith('"') else word
    var = re.match(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?", raw)
    if var:
        name = var.group(1)
        value = assigns.get(name)
        if value is None and name == "TMPDIR":
            value = os.environ.get("TMPDIR")
        if not value:
            return None
        raw = value + raw[var.end() :]
    path = os.path.expanduser(raw)
    return os.path.realpath(os.path.join(base, path)) + ("/" if raw.endswith("/") else "")


def recursive_targets(raw_text: str) -> list[str] | None:
    """Every recursive-rm target as a resolved real path; ["?"] outside the plain shape.

    ["NONE"] means no rm word survives in the executable text (the rm was heredoc
    DATA), so nothing is deleted. A heredoc fed to an interpreter is code, not data.
    """
    if not _DELETE_WORD.search(raw_text):
        return ["NONE"]
    code_lines, parsed = _strict_split(raw_text)
    if not parsed:
        return ["?"]
    if not _DELETE_WORD.search("\n".join(code_lines)):
        # The rm word lives only in a heredoc body. That body is DATA only when every
        # heredoc line is a known data-writing shape; any other consumer (a pipe, a
        # process substitution, an interpreter we did not list) may execute it.
        # Allow-list, not a list of interpreters (ninth security review of #278).
        # Every executable line must be a data-writing heredoc or an inert command:
        # `bash file` after writing it would run the body (tenth review of #278).
        heredoc_lines = [line for line in code_lines if "<<" in line]
        # An UNQUOTED delimiter makes bash expand $(..), `..` and ${..} in the body
        # while writing it, so a substitution there RUNS (twelfth review of #278).
        expands = any((found := _sink(line)) is not None and found.group("w") for line in heredoc_lines) and any(
            token in raw_text for token in ("$(", "`", "${")
        )
        if heredoc_lines and not expands and all(_sink(line) or _INERT_LINE.fullmatch(line.strip()) for line in code_lines):
            return ["NONE"]
        return ["?"]
    if len(code_lines) != 1:
        return ["?"]
    match = _PLAIN_RM_RF.fullmatch(code_lines[0].strip())
    if not match:
        return ["?"]
    assigns: dict[str, str] = {}
    for name, value in re.findall(r"([A-Za-z_][A-Za-z0-9_]*)=(\S+?)[ \t]*(?:;|&&)", match.group("assigns") or ""):
        if name in _RESOLUTION_VARS:
            return ["?"]
        assigns[name] = value
    cwds = _cwds()
    base = cwds[0]
    words = [match.group("cd") or "", *match.group("targets").split()]
    # Two candidate cwds and a relative word that no `cd` anchors: the arm cannot know which one
    # bash will use, so it judges neither.
    if (
        len(cwds) > 1
        and not match.group("cd")
        and any(w and not w.strip('"').startswith(("/", "~", "$")) for w in match.group("targets").split())
    ):
        return ["?"]
    # An operand that starts with "-" is an option to bash (`cd -L /etc` changes to
    # /etc), never a path; reading it as one judges the wrong directory.
    if any(w.strip('"').startswith("-") for w in words if w):
        return ["?"]
    # Only after option-like operands are refused (`--recursive` is one): otherwise a
    # long option reads as "not recursive" and the arm is told nothing is deleted.
    if not re.search(r"[rR]", match.group("flags") or ""):
        return ["NONE"]  # not recursive: the rm -rf arm has nothing to judge
    # bash does not expand ~ inside double quotes, and a relative cd follows CDPATH;
    # resolving either here would judge a different path from the one deleted.
    if any(w.startswith('"~') for w in words if w):
        return ["?"]
    cd_word = (match.group("cd") or "").strip('"')
    if cd_word and not cd_word.startswith(("/", "~/", "$TMPDIR", "${TMPDIR}")):
        return ["?"]
    if match.group("cd"):
        cd_dest = _literal_path(match.group("cd"), base, assigns)
        if cd_dest is None:
            return ["?"]
        base = cd_dest.rstrip("/") or "/"
    out: list[str] = []
    for word in match.group("targets").split():
        resolved = _literal_path(word, base, assigns)
        if resolved is None:
            return ["?"]
        out.append(resolved)
    return out


def main() -> int:
    raw_text = sys.stdin.read()
    if "--rm-rf-targets" in sys.argv[1:]:
        targets = recursive_targets(raw_text)
        if targets is None:
            return 1
        print("\n".join(targets))
        return 0
    if "--store-mention" in sys.argv[1:]:
        return 0 if store_mention_is_harmless(raw_text) else 1
    if "--review-accepted" in sys.argv[1:]:
        return 0 if review_accepted(raw_text) else 1
    found = analyze(raw_text)
    if not found:
        return 0
    owner_only = [f for f in found if f.owner_only]
    if owner_only and all(_REWRITE_MARK in f.why for f in owner_only):
        print(_rewrite_request(owner_only), file=sys.stderr)
        return REVIEW_REQUIRED
    if owner_only:
        print(_owner_request(owner_only), file=sys.stderr)
        return REVIEW_REQUIRED
    tokens = [f for f in found if f.needs_token]
    if tokens:
        print(_token_request(tokens), file=sys.stderr)
        return REVIEW_REQUIRED
    found = [f for f in found if not f.needs_token]
    answers = review_answers(raw_text)
    if answers and all(_backup_ok(f, answers[2]) for f in found if f.needs_backup):
        return 0
    print(_review_request(found, answers), file=sys.stderr)
    return REVIEW_REQUIRED


if __name__ == "__main__":
    sys.exit(main())
